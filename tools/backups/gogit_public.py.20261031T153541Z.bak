STEP_RE = re.compile(r"PHASE03-SMOLTALK-[A-Z0-9][A-Z0-9-]{3,80}\Z")
METRIC_RE = re.compile(r"([A-Z][A-Z0-9_]+):\s*([0-9]+)\Z")


def git(*args):
    p = subprocess.run(["git", "-C", str(REPO), *args], text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       check=False)
    if p.returncode != 0:
        raise RuntimeError(
            f"Git command failed ({' '.join(args[:2])}): {p.stderr.strip()}"
        )
    return p.stdout.strip()


def require_clean_synchronized():
    if git("branch", "--show-current") != "main":
        raise RuntimeError("Expected branch main")
    if git("status", "--porcelain"):
        raise RuntimeError("Git worktree/index not clean; publication blocked")
    git("fetch", "--quiet", "origin", "main")
    if git("rev-parse", "HEAD") != git("rev-parse", "origin/main"):
        raise RuntimeError("Local and remote main differ; synchronize before publishing")


def checked_audit(path_string):
    path = (REPO / path_string).resolve()
    try:
        rel = path.relative_to(AUDITS.resolve())
    except ValueError as exc:
        raise RuntimeError("Audit is outside tools/public-audits") from exc
    if not path.is_file() or path.suffix != ".py" or rel.parent != Path("."):
        raise RuntimeError("Only direct tools/public-audits/*.py files are allowed")
    tracked = str(path.relative_to(REPO))
    git("ls-files", "--error-unmatch", "--", tracked)
    if git("status", "--porcelain", "--", tracked):
        raise RuntimeError("Audit script must be committed and clean")
    return path, tracked


def source_for_audit(tracked):
    if tracked.startswith("tools/public-audits/phase03_v54_"):
        return SOURCE_PHASE03_VALIDATION
    if tracked.startswith("tools/public-audits/phase03_v55_blind_"):
        return SOURCE_PHASE03_BLIND
    if tracked.startswith("tools/public-audits/phase03_v56_tokenizer_"):
        return SOURCE_PHASE03_TOKENIZER
    if tracked.startswith("tools/public-audits/phase03_v57_"):
        return SOURCE_PHASE03_ARCHITECTURE
    if tracked.startswith("tools/public-audits/phase03_v58_"):
        return SOURCE_PHASE03_ARCHITECTURE_FINAL
    if tracked.startswith("tools/public-audits/phase03_v59_"):
        return SOURCE_PHASE03_V59
    if tracked.startswith("tools/public-audits/phase03_v60_"):
        return SOURCE_PHASE03_V60
    if tracked.startswith("tools/public-audits/phase03_v61_"):
        return SOURCE_PHASE03_V61
    if tracked.startswith("tools/public-audits/phase03_v62_"):
        return SOURCE_PHASE03_V62
    if tracked.startswith("tools/public-audits/phase03_v63_"):
        return SOURCE_PHASE03_V63
    return SOURCE


def semantic_validation_complete_for_audit(tracked, metrics):
    closure = tracked == "tools/public-audits/phase03_v54_validation_closure.py"
    blind_workstream = tracked.startswith("tools/public-audits/phase03_v55_blind_")
    tokenizer_workstream = tracked.startswith(
        "tools/public-audits/phase03_v56_tokenizer_"
    )
    post_authorization_v59 = tracked in {
        "tools/public-audits/phase03_v59_final_mix_freeze_authorization.py",
        "tools/public-audits/phase03_v59_persistent_trainer_freeze.py",
        "tools/public-audits/phase03_v59_tokenizer_performance.py",
        "tools/public-audits/phase03_v59_validation_compatibility.py",
        "tools/public-audits/phase03_v59_bounded_pilot_run.py",
        "tools/public-audits/phase03_v59_post_train_validation.py",
        "tools/public-audits/phase03_v59_post_train_generation_diagnostic.py",
        "tools/public-audits/phase03_v59_logit_initialization_diagnostic.py",
    }

    post_authorization_v60 = tracked in {
        "tools/public-audits/phase03_v60_training_authorization.py",
        "tools/public-audits/phase03_v60_persistent_trainer_freeze.py",
    }

    active_training_v60 = tracked in {
        "tools/public-audits/phase03_v60_train_run_001.py",
        "tools/public-audits/phase03_v60_train_run_002.py",
        "tools/public-audits/phase03_v60_eos_assistant_turn_target_diagnostic.py",
        "tools/public-audits/phase03_v60_eos_logit_rank_calibration_diagnostic.py",
        "tools/public-audits/phase03_v60_eos_competitor_logit_margin_bias_sweep.py",
    }

    post_authorization_v61 = tracked in {
        "tools/public-audits/phase03_v61_training_authorization.py",
        "tools/public-audits/phase03_v61_persistent_trainer_freeze.py",
    }

    active_training_v61 = tracked in {
        "tools/public-audits/phase03_v61_train_run_001.py",
        "tools/public-audits/phase03_v61_train_run_001_eos_calibration.py",
    }

    post_authorization_v62 = tracked in {
        "tools/public-audits/phase03_v62_training_authorization.py",
        "tools/public-audits/phase03_v62_persistent_trainer_freeze.py",
    }

    active_training_v62 = tracked in {
        "tools/public-audits/phase03_v62_train_run_001.py",
        "tools/public-audits/phase03_v62_train_run_001_eos_calibration.py",
    }

    v63_diagnostic = tracked in {
        "tools/public-audits/phase03_v63_diagnostic_preflight.py",
        "tools/public-audits/phase03_v63_diagnostic_preflight_002.py",
    }

    v63_generation_failure = tracked == (
        "tools/public-audits/phase03_v63_generation_failure_analysis_001.py"
    )

    v63_decoding_ablation = tracked == (
        "tools/public-audits/phase03_v63_decoding_ablation_001.py"
    )

    v63_decoding_robustness = tracked == (
        "tools/public-audits/phase03_v63_decoding_robustness_001.py"
    )

    v63_human_review = tracked == (
        "tools/public-audits/phase03_v63_semantic_generation_review_001.py"
    )
    v63_auto_language_screen = tracked == (
        "tools/public-audits/phase03_v63_automatic_language_screen_001.py"
    )

    architecture_workstream = tracked.startswith(
        (
            "tools/public-audits/phase03_v57_",
            "tools/public-audits/phase03_v58_",
            "tools/public-audits/phase03_v59_",
            "tools/public-audits/phase03_v60_",
            "tools/public-audits/phase03_v61_",
            "tools/public-audits/phase03_v62_",
        )
    )

    if post_authorization_v59:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("V59_MIX_FINALIZED") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
        )

    if post_authorization_v60:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 0
        )

    if active_training_v60:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
        )

    if post_authorization_v61:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 0
        )

    if active_training_v61:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
        )

    if post_authorization_v62:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 0
        )

    if active_training_v62:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
        )

    if v63_diagnostic:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
            and metrics.get("V63_DIAG_PREFLIGHT_PASS") == 1
            and metrics.get("V63_DIAG_BLIND_ACCESS") == 0
        )

    if v63_generation_failure:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
            and metrics.get("V63_FAIL_PASS") == 1
            and metrics.get("V63_FAIL_BLIND_ACCESS") == 0
            and metrics.get("V63_FAIL_GPU_BF16") == 1
        )

    if v63_decoding_ablation:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
            and metrics.get("V63_ABL_PASS") == 1
            and metrics.get("V63_ABL_BLIND_ACCESS") == 0
            and metrics.get("V63_ABL_GPU_BF16") == 1
            and metrics.get("V63_ABL_PROBES_PER_MODE") == 6
        )
    
    if v63_decoding_robustness:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 1
            and metrics.get("TRAINING_STARTED") == 1
            and metrics.get("V63_ROB_PASS") == 1
            and metrics.get("V63_ROB_BLIND_ACCESS") == 0
            and metrics.get("V63_ROB_GPU_BF16") == 1
            and metrics.get("V63_ROB_SEEDS") == 8
        )
    
    if v63_human_review:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 0
            and metrics.get("TRAINING_STARTED") == 0
            and metrics.get("V63_HUM_PASS") == 1
            and metrics.get("V63_HUM_BLIND_ACCESS") == 0
            and metrics.get("V63_HUM_SAMPLES") == 24
            and metrics.get("V63_HUM_REVIEWED") == 24
        )
    if v63_auto_language_screen:
        # This is NOT semantic validation. Keep the metadata false.
        return False

    if tokenizer_workstream or architecture_workstream:
        return (
            metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
            and metrics.get("TRAINING_AUTHORIZED") == 0
        )

    return (
        (closure or blind_workstream)
        and metrics.get("SEMANTIC_VALIDATION_COMPLETE") == 1
        and metrics.get("BLIND_AUTHORING_AUTHORIZED") == 1
        and metrics.get("TRAINING_AUTHORIZED") == 0
    )


def numeric_metrics(raw):
    if raw.count(MARKER) != 1:
        raise RuntimeError("Expected exactly one results marker")
    suffix = raw.split(MARKER, 1)[1].strip()
    if not suffix:
        raise RuntimeError("No public numeric results found")
    metrics = {}
    for line in suffix.splitlines():
        match = METRIC_RE.fullmatch(line.strip())
        if not match:
            raise RuntimeError("Non-numeric or unstructured result rejected")
        key, value = match.groups()
        if key not in METRIC_KEYS or key in metrics:
            raise RuntimeError("Unknown or repeated metric rejected")
        metrics[key] = int(value)
        if metrics[key] > 100000000:
            raise RuntimeError("Unreasonably large metric rejected")
    if len(metrics) > 30:
        raise RuntimeError("Too many metrics")
    return dict(sorted(metrics.items()))


def main():
    parser = argparse.ArgumentParser(
        description="Run a vetted public Phase 03 audit, commit and push numeric reports"
    )
    parser.add_argument("--step", required=True)
    parser.add_argument("--audit", required=True)
    args = parser.parse_args()
    if not STEP_RE.fullmatch(args.step):
        parser.error("STEP_ID must match PHASE03-SMOLTALK-[A-Z0-9-]")
    try:
        require_clean_synchronized()
        audit_path, tracked = checked_audit(args.audit)
        history = REPORTS / "history"
        out_json = history / (args.step + ".json")
        out_txt = history / (args.step + ".txt")
        if out_json.exists() or out_txt.exists():
            raise RuntimeError("STEP_ID history exists; overwriting forbidden")
        if not (REPORTS / "latest.json").is_file() or not (
            REPORTS / "latest.txt"
        ).is_file():
            raise RuntimeError("Existing latest reports not found")

        execution = subprocess.run(
            [sys.executable, str(audit_path)],
            cwd=REPO, capture_output=True, text=True, timeout=300,
            check=False
        )
        if execution.returncode:
            raise RuntimeError(
                f"Audit exited with status {execution.returncode}; nothing published"
            )
        metrics = numeric_metrics(execution.stdout)
        training_authorized = metrics.get("TRAINING_AUTHORIZED") == 1
        report = {
            "step_id": args.step,
            "project": "Mini-Kuzai",
            "phase": "03",
            "source": source_for_audit(tracked),
            "producer": tracked,
            "producer_sha256": hashlib.sha256(
                audit_path.read_bytes()
            ).hexdigest(),
            "status": (
                "TRAINING_AUTHORIZATION_GATE"
                if training_authorized
                else "PUBLIC_AGGREGATE_REVIEW_ONLY"
            ),
            "metrics": metrics,
            "semantic_validation_complete": semantic_validation_complete_for_audit(tracked, metrics),
            "training_authorized": training_authorized,
            "private_conversation_data_included": False,
        }
        text_json = json.dumps(
            report, indent=2, ensure_ascii=True, sort_keys=True
        ) + "\n"
        text_txt = (
            f"STEP_ID: {args.step}\n{MARKER}\n"
            + "".join(f"{k}: {v}\n" for k, v in metrics.items())
            + "STATUS: {}\n".format(
                "TRAINING_AUTHORIZATION_GATE"
                if training_authorized
                else "PUBLIC_AGGREGATE_REVIEW_ONLY"
            )
            + "SEMANTIC_VALIDATION_COMPLETE: {}\n".format(
                "TRUE" if semantic_validation_complete_for_audit(tracked, metrics) else "FALSE"
            )
            + "TRAINING_AUTHORIZED: {}\n".format(
                "TRUE" if training_authorized else "FALSE"
            )
        )

        old_files = {
            name: (REPORTS / name).read_bytes()
            for name in ("latest.json", "latest.txt")
        }
        backup_root = Path("/root/Mini-Kuzai/backups/gogit")
        backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
        backup = Path(
            tempfile.mkdtemp(prefix="auto-", dir=backup_root)
        )
        os.chmod(backup, 0o700)
        for name, blob in old_files.items():
            (backup / name).write_bytes(blob)
        print("BACKUP:", backup)

        allowed = {
            str((REPORTS / "latest.json").relative_to(REPO)),
            str((REPORTS / "latest.txt").relative_to(REPO)),
            str(out_json.relative_to(REPO)),
            str(out_txt.relative_to(REPO)),
        }
        committed = False
        try:
            (REPORTS / "latest.json").write_text(
                text_json, encoding="utf-8"
            )
            (REPORTS / "latest.txt").write_text(
                text_txt, encoding="utf-8"
            )
            out_json.write_text(text_json, encoding="utf-8")
            out_txt.write_text(text_txt, encoding="utf-8")
            git("add", "--", *sorted(allowed))
            staged = set(git("diff", "--cached", "--name-only").splitlines())
            if staged != allowed:
                raise RuntimeError("Unexpected staged files; commit blocked")
            git("diff", "--cached", "--check")
            git(
                "commit", "-m",
                f"Phase03 public audit {args.step}"
            )
            committed = True
        except Exception:
            if not committed:
                git("reset", "--quiet", "--", *sorted(allowed))
                for name, blob in old_files.items():
                    (REPORTS / name).write_bytes(blob)
                out_json.unlink(missing_ok=True)
                out_txt.unlink(missing_ok=True)
            raise

        push = subprocess.run(
            ["git", "-C", str(REPO), "push", "origin", "main"],
            capture_output=True, text=True, check=False
        )
        if push.returncode:
            raise RuntimeError(
                "Commit created but push failed. Inspect Git; never force push."
            )
        git("fetch", "--quiet", "origin", "main")
        if git("rev-parse", "HEAD") != git("rev-parse", "origin/main"):
            raise RuntimeError("Push successful but remote verification failed")
        print(MARKER)
        print("PUSH: OK")
        print("STEP_ID:", args.step)
        print("PUBLIC_METRICS:", len(metrics))
        print("HEAD:", git("rev-parse", "--short", "HEAD"))
        print("GOGIT: READY")
    except (RuntimeError, subprocess.TimeoutExpired) as exc:
        print(MARKER)
        print("PUSH: NOT_CONFIRMED")
        print("ERROR:", str(exc))
        sys.exit(1)


if __name__ == "__main__":
    main()
